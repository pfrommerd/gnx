from typing import NoReturn, final
from uuid import UUID

from jax import Device as _NativeDevice

@final
class JaxDevice:
    def __new__(cls, _unavailable: NoReturn, /) -> JaxDevice: ...
    @staticmethod
    def from_native(device: _NativeDevice) -> JaxDevice: ...
    @property
    def uuid(self) -> UUID: ...
    @property
    def platform(self) -> str: ...
    @property
    def hardware_id(self) -> str: ...
    @property
    def hardware_kind(self) -> str: ...
    @property
    def native(self) -> _NativeDevice: ...

def devices(backend: str | None = None) -> list[JaxDevice]: ...
