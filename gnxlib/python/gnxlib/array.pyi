from collections.abc import Sequence
from types import EllipsisType
from typing import NoReturn, final

from .dtype import DType

@final
class Array:
    def __new__(cls, _unavailable: NoReturn, /) -> Array: ...
    @property
    def shape(self) -> tuple[int | None, ...]: ...
    @property
    def dtype(self) -> DType: ...
    def __bool__(self) -> NoReturn: ...

@final
class ArrayRef:
    def __new__(cls, _unavailable: NoReturn, /) -> ArrayRef: ...
    @property
    def shape(self) -> tuple[int | None, ...]: ...
    @property
    def dtype(self) -> DType: ...
    def __getitem__(self, key: slice | EllipsisType, /) -> Array: ...
    def __setitem__(self, key: slice | EllipsisType, value: Array, /) -> None: ...

def placeholder(shape: Sequence[int], dtype: DType = "float32") -> Array: ...
def new_ref(x: Array) -> ArrayRef: ...
