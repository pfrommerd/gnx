from collections.abc import Sequence
from typing import NoReturn, final
from uuid import UUID

from .array import Array

@final
class XlaDevice:
    def __new__(cls, _unavailable: NoReturn, /) -> XlaDevice: ...
    @property
    def platform(self) -> str: ...
    @property
    def host_uuid(self) -> UUID: ...
    @property
    def hardware_kind(self) -> str: ...
    @property
    def device_ordinal(self) -> int: ...
    async def eval(self, roots: object) -> None: ...
    def to_host_bytes(self, array: Array) -> bytes: ...

def devices() -> list[XlaDevice]: ...

@final
class MeshWorker:
    def __new__(cls, _unavailable: NoReturn, /) -> MeshWorker: ...
    @property
    def address(self) -> str: ...
    @property
    def host_uuid(self) -> UUID: ...
    @property
    def allocation_owner_uuid(self) -> UUID: ...
    @property
    def device_ordinal(self) -> int: ...

@final
class Mesh:
    def __new__(cls, _unavailable: NoReturn, /) -> Mesh: ...
    @staticmethod
    async def connect(axis: str, workers: Sequence[str]) -> Mesh: ...
    @property
    def axis(self) -> str: ...
    @property
    def workers(self) -> list[MeshWorker]: ...
    async def upload(self, array: Array, *, axes: Sequence[Sequence[str]] | None = None) -> Array: ...
    async def eval(self, roots: object) -> None: ...
    async def to_host_bytes(self, array: Array) -> bytes: ...

def constrain(array: Array, axes: Sequence[Sequence[str]]) -> Array: ...
def replicate(array: Array) -> Array: ...
