from typing import NoReturn, final
from uuid import UUID

from .array import Array

@final
class XlaDevice:
    def __new__(cls, _unavailable: NoReturn, /) -> XlaDevice: ...
    @property
    def platform(self) -> str: ...
    @property
    def host_uuid(self) -> UUID: ...
    @property
    def hardware_kind(self) -> str: ...
    @property
    def device_ordinal(self) -> int: ...
    async def eval(self, roots: object) -> None: ...
    def to_host_bytes(self, array: Array) -> bytes: ...

def devices() -> list[XlaDevice]: ...
