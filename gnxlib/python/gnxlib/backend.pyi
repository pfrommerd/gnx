from typing import NoReturn, final
from uuid import UUID

@final
class Backend:
    def __new__(cls, _unavailable: NoReturn, /) -> Backend: ...
    def name(self) -> str: ...

@final
class Device:
    def __new__(cls, _unavailable: NoReturn, /) -> Device: ...
    @property
    def uuid(self) -> UUID: ...
    @property
    def platform(self) -> str: ...
    @property
    def hardware_id(self) -> str: ...
    @property
    def hardware_kind(self) -> str: ...

def backends() -> list[Backend]: ...
def devices() -> list[Device]: ...
def enable_jax_backend() -> Backend: ...
